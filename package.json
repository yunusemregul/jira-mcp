{
  "name": "@yunusemregul/jira-mcp",
  "version": "1.0.0",
  "description": "Local MCP server for Jira Cloud — search, create, update, comment, transition and inspect attachments using an Atlassian API token",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jira",
    "jira-cloud",
    "atlassian",
    "codex",
    "claude"
  ],
  "author": "Yunus Emre Gül <yunemregul@gmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/yunusemregul/jira-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunusemregul/jira-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/yunusemregul/jira-mcp/issues"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "type": "module",
  "main": "server.js",
  "bin": {
    "jira-mcp": "bin/jira-mcp.mjs"
  },
  "files": [
    "bin",
    "tools",
    "static",
    "server.js",
    "jira.js",
    "storage.js",
    ".env.example",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node server.js",
    "lint": "eslint .",
    "test": "node --test",
    "verify": "npm run lint && npm test",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0"
  }
}
