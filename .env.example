# Jira credentials are configured in the local Web UI and stored in
# ~/.jira-mcp/sites.json with user-only filesystem permissions.

# Optional: override the loopback host and port.
# Keep HOST on a loopback address unless you add a trusted reverse proxy and authentication.
# HOST=127.0.0.1
# PORT=18433

# Optional request and attachment safety limits.
# JIRA_REQUEST_TIMEOUT_MS=30000
# JIRA_MAX_ATTACHMENT_BYTES=20971520

# Optional: the attachment_to_markdown tool shells out to Microsoft markitdown.
# By default it tries "markitdown", then "uvx markitdown". Set this to use a
# specific install instead. Only this one tool needs it.
# JIRA_MARKITDOWN_CMD=/opt/venv/bin/markitdown
# JIRA_MARKITDOWN_TIMEOUT_MS=120000
# JIRA_MARKITDOWN_MAX_CHARS=200000
